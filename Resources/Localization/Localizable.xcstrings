    "selector.drag": {
      "comment": "User-facing text: Drag to select — Space picks a window · hold ⇧ locks aspect · hold ⌃ snaps to standard sizes · Esc cancels",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to select — Space picks a window · hold ⇧ locks aspect · hold ⌃ snaps to standard sizes · Esc cancels"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Auswählen ziehen — Leertaste wählt ein Fenster · ⇧ halten sperrt das Seitenverhältnis · ⌃ halten rastet auf Standardgrößen ein · Esc bricht ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour sélectionner — Espace choisit une fenêtre · maintenez ⇧ pour verrouiller les proportions · maintenez ⌃ pour ajuster aux tailles standard · Échap annule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para seleccionar — Espacio elige una ventana · mantén ⇧ para bloquear la proporción · mantén ⌃ para ajustar a tamaños estándar · Esc cancela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以选择——空格键选择窗口 · 按住 ⇧ 锁定宽高比 · 按住 ⌃ 吸附到标准大小 · Esc 取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして選択 — Spaceでウインドウを選択 · ⇧を押したまま縦横比を固定 · ⌃を押したまま標準サイズにスナップ · Escでキャンセル"
          }
        }
      }
    },
    "selector.pickWindow": {
