    "settings.recording.screenshotCaption": {
      "comment": "User-facing text: Taken from the hotbar's camera button while sharing — the picture is exactly the shared output, including privacy exclusions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken from the hotbar's camera button while sharing — the picture is exactly the shared output, including privacy exclusions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird während einer Freigabe mit der Kamera-Taste der Aktionsleiste aufgenommen — das Bild entspricht genau der geteilten Ausgabe einschließlich der Privatsphärenausschlüsse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise avec le bouton appareil photo de la barre d’actions pendant un partage : l’image correspond exactement à la sortie partagée, exclusions de confidentialité comprises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se toma con el botón de cámara de la barra de acciones mientras compartes; la imagen coincide exactamente con la salida compartida, incluidas las exclusiones de privacidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享时通过操作栏的相机按钮截取，图像与共享输出完全一致，包括隐私排除项。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有中に操作バーのカメラボタンで撮影します。画像はプライバシー除外を含む共有出力そのものです。"
          }
        }
      }
    },
