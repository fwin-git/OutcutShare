    "settings.shortcuts.caption": {
      "comment": "User-facing text: Shortcuts work system-wide while OutcutShare is running. Any key combination can be recorded — Esc cancels recording.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts work system-wide while OutcutShare is running. Any key combination can be recorded — Esc cancels recording."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzbefehle funktionieren systemweit, solange OutcutShare läuft. Jede Tastenkombination kann aufgezeichnet werden — Esc bricht die Aufzeichnung ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis fonctionnent dans tout le système lorsque OutcutShare est en cours d’exécution. Toute combinaison peut être enregistrée ; Échap annule l’enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos funcionan en todo el sistema mientras OutcutShare está en ejecución. Se puede grabar cualquier combinación; Esc cancela la grabación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OutcutShare 运行时，快捷键在整个系统中有效。可录入任意组合，按 Esc 取消录入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OutcutShareの実行中はシステム全体でショートカットが有効です。任意のキーの組み合わせを記録でき、Escでキャンセルします。"
          }
        }
      }
    },
    "settings.shortcuts.conflict": {
      "comment": "User-facing text: Also assigned to %@ — only the first assignment is active.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also assigned to %@ — only the first assignment is active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch %@ zugewiesen — nur die erste Belegung ist aktiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Également attribué à %@ — seule la première attribution est active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También está asignado a %@; solo la primera asignación está activa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也分配给 %@——只有第一个分配生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にも割り当てられています。最初の割り当てだけが有効です。"
          }
        }
      }
