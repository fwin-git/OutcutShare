    "settings.general.hotbarCaption": {
      "comment": "User-facing text: Quick actions next to the region. Drag the ≡ grabber to reposition; ✕ hides it until re-enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick actions next to the region. Drag the ≡ grabber to reposition; ✕ hides it until re-enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellaktionen neben dem Bereich. Ziehe den ≡-Griff zum Verschieben; ✕ blendet die Leiste aus, bis sie wieder aktiviert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions rapides à côté de la zone. Faites glisser la poignée ≡ pour la déplacer ; ✕ la masque jusqu’à sa réactivation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones rápidas junto a la región. Arrastra el tirador ≡ para cambiarla de posición; ✕ la oculta hasta que se vuelva a activar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域旁的快捷操作。拖动 ≡ 手柄可重新定位；点按 ✕ 会隐藏，直到再次启用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲の横にクイック操作を表示します。≡ハンドルをドラッグして移動し、✕で再度有効にするまで非表示にします。"
          }
        }
      }
    },
