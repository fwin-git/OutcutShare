    "settings.privacy.notificationsCaption": {
      "comment": "User-facing text: Banners still appear on your screen — they're removed only from the shared picture.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners still appear on your screen — they're removed only from the shared picture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner erscheinen weiterhin auf deinem Bildschirm — sie werden nur aus dem geteilten Bild entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bannières restent visibles sur votre écran ; elles sont uniquement retirées de l’image partagée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos siguen apareciendo en tu pantalla; solo se eliminan de la imagen compartida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅仍会显示在你的屏幕上，只会从共享画面中移除。"
