    "settings.shortcuts.risky": {
      "comment": "User-facing text: No modifier key — this swallows every “%@” keystroke system-wide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No modifier key — this swallows every “%@” keystroke system-wide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sondertaste — dadurch wird jeder „%@“-Tastendruck systemweit abgefangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune touche de modification — toutes les frappes « %@ » seront interceptées dans tout le système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tecla modificadora: esto intercepta cada pulsación de «%@» en todo el sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有修饰键——这会在整个系统中拦截每次“%@”按键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーがないため、システム全体ですべての「%@」入力を奪います。"
          }
        }
      }
    },
