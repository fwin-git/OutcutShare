          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "esquinas y bordes redimensionan · ⇧ bloque la proporción · ⌃ ajusta a tamaños estándar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
