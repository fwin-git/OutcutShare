    "settings.general.crispCaption": {
      "comment": "User-facing text: Renders the shared monitor at 2× pixel density: sharpest with Retina sources, reduces compression artifacts otherwise. Uses more bandwidth. Virtual Display mode only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders the shared monitor at 2× pixel density: sharpest with Retina sources, reduces compression artifacts otherwise. Uses more bandwidth. Virtual Display mode only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert den geteilten Monitor mit doppelter Pixeldichte: am schärfsten mit Retina-Quellen, sonst weniger Kompressionsartefakte. Benötigt mehr Bandbreite. Nur im Modus „Virtuelles Display“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le moniteur partagé avec une densité de pixels 2× : netteté maximale avec les sources Retina et moins d’artefacts de compression dans les autres cas. Utilise davantage de bande passante. Mode Écran virtuel uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza el monitor compartido con una densidad de píxeles 2×: máxima nitidez con fuentes Retina y menos artefactos de compresión en otros casos. Usa más ancho de banda. Solo en modo Pantalla virtual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 2 倍像素密度渲染共享显示器：Retina 来源最清晰，其他来源可减少压缩伪影。会占用更多带宽。仅适用于虚拟显示器模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有モニターを2倍のピクセル密度で描画します。Retinaソースでは最も鮮明になり、それ以外では圧縮ノイズを軽減します。帯域幅を多く使用します。仮想ディスプレイモードのみ。"
          }
        }
      }
    },
    "settings.general.crispText": {
      "comment": "User-facing text: Crisp text (Retina output)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
