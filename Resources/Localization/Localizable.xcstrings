    "settings.general.zoomCaption": {
      "comment": "User-facing text: Zoom In / Out (⌃⌥⌘Z) magnifies the shared picture toward your cursor and gently tracks it — your own screen never changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom In / Out (⌃⌥⌘Z) magnifies the shared picture toward your cursor and gently tracks it — your own screen never changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößern / Verkleinern (⌃⌥⌘Z) zoomt das geteilte Bild in Richtung des Mauszeigers und folgt ihm sanft — dein eigener Bildschirm bleibt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom avant / arrière (⌃⌥⌘Z) agrandit l’image partagée vers le pointeur et le suit en douceur, sans modifier votre écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar / alejar (⌃⌥⌘Z) amplía la imagen compartida hacia el puntero y lo sigue suavemente; tu propia pantalla no cambia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 / 缩小（⌃⌥⌘Z）会朝指针放大共享画面并平滑跟随，而你的屏幕不会改变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン／アウト（⌃⌥⌘Z）は共有映像をポインタに向かって拡大し、滑らかに追従します。自分の画面は変わりません。"
          }
        }
      }
    },
