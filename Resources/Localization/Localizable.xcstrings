    "settings.presets.empty": {
      "comment": "User-facing text: No presets yet. While sharing, choose menu bar → Presets → “Save Current Region as Preset…”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No presets yet. While sharing, choose menu bar → Presets → “Save Current Region as Preset…”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Voreinstellungen. Wähle während einer Freigabe Menüleiste → Voreinstellungen → „Aktuellen Bereich als Voreinstellung sichern…“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun préréglage. Pendant un partage, choisissez barre des menus → Préréglages → « Enregistrer la zone actuelle comme préréglage… »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay preajustes. Mientras compartes, elige barra de menús → Preajustes → «Guardar región actual como preajuste…»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无预设。共享时，请选择菜单栏 → 预设 →“将当前区域存为预设…”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットはまだありません。共有中にメニューバー → プリセット →「現在の範囲をプリセットとして保存…」を選択してください。"
          }
        }
      }
    },
