    "settings.privacy.noHiddenApps": {
      "comment": "User-facing text: No hidden apps. Windows of apps you add here never appear in the shared picture — viewers see what's behind them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hidden apps. Windows of apps you add here never appear in the shared picture — viewers see what's behind them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine ausgeblendeten Apps. Fenster von Apps, die du hier hinzufügst, erscheinen nie im geteilten Bild — Zuschauer sehen den Inhalt dahinter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app masquée. Les fenêtres des apps ajoutées ici n’apparaissent jamais dans l’image partagée : les spectateurs voient ce qui se trouve derrière."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay apps ocultas. Las ventanas de las apps que añadas aquí nunca aparecerán en la imagen compartida; los espectadores verán lo que haya detrás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有隐藏的 App。添加到此处的 App 窗口不会出现在共享画面中，观众会看到其后方的内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のアプリはありません。ここに追加したアプリのウインドウは共有映像に表示されず、視聴者には背後の内容が見えます。"
          }
        }
      }
    },
