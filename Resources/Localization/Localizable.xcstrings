    "mover.instructions": {
      "comment": "User-facing text: Drag to move — %@ · Space picks a window (moves while resizing) · ⏎ commits · ⎋ cancels",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move — %@ · Space picks a window (moves while resizing) · ⏎ commits · ⎋ cancels"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bewegen ziehen — %@ · Leertaste wählt ein Fenster (Verschieben während der Größenänderung) · ⏎ übernimmt · ⎋ bricht ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer — %@ · Espace choisit une fenêtre (déplacement pendant le redimensionnement) · ⏎ valide · ⎋ annule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para mover — %@ · Espacio elige una ventana (se mueve al redimensionar) · ⏎ confirma · ⎋ cancela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以移动——%@ · 空格键选择窗口（调整大小时可移动）· ⏎ 确认 · ⎋ 取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして移動 — %@ · Spaceでウインドウを選択（サイズ変更中も移動）· ⏎で確定 · ⎋でキャンセル"
          }
        }
      }
    },
    "mover.pickWindow": {
      "comment": "User-facing text: Click a window to snap the region to it — Space returns, Esc cancels",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a window to snap the region to it — Space returns, Esc cancels"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ein Fenster klicken, um den Bereich daran auszurichten — Leertaste kehrt zurück, Esc bricht ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une fenêtre pour y ajuster la région — Espace revient, Échap annule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en una ventana para ajustar la región a ella; Espacio vuelve y Esc cancela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按窗口以将区域吸附到该窗口——空格键返回，Esc 取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウをクリックして領域を合わせる — Spaceで戻る、Escでキャンセル"
          }
        }
      }
    },
    "mover.resizeFree": {
      "comment": "User-facing text: corners & edges resize · ⇧ locks aspect · ⌃ snaps to standard sizes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "corners & edges resize · ⇧ locks aspect · ⌃ snaps to standard sizes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecken und Kanten ändern die Größe · ⇧ sperrt das Seitenverhältnis · ⌃ rastet auf Standardgrößen ein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
