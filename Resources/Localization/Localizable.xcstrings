    "permissions.accessibility.granted": {
      "comment": "User-facing text: Granted — drag windows onto the virtual monitor's preview to move them there.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted — drag windows onto the virtual monitor's preview to move them there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilt — ziehe Fenster auf die Vorschau des virtuellen Monitors, um sie dorthin zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordée — faites glisser des fenêtres sur l’aperçu du moniteur virtuel pour les y déplacer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedido: arrastra ventanas a la vista previa del monitor virtual para moverlas allí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权——将窗口拖到虚拟显示器预览中即可移入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み — ウインドウを仮想モニターのプレビューへドラッグすると移動できます。"
          }
        }
      }
    },
    "permissions.accessibility.pending": {
      "comment": "User-facing text: Lets you move windows onto the Virtual Monitor by dropping them on its preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you move windows onto the Virtual Monitor by dropping them on its preview."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kannst du Fenster auf den virtuellen Monitor verschieben, indem du sie auf dessen Vorschau ablegst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de déplacer des fenêtres vers le moniteur virtuel en les déposant sur son aperçu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite mover ventanas al monitor virtual soltándolas en su vista previa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许你将窗口拖放到预览中，从而移至虚拟显示器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューへドロップしてウインドウを仮想モニターへ移動できるようにします。"
          }
        }
      }
    },
    "permissions.accessibility.title": {
