    "settings.recording.recordingCaption": {
      "comment": "User-facing text: Start/stop with ⌃⌥⌘R, the hotbar, or the menu bar while sharing. Recordings use the capture frame rate set under General and pause together with privacy pause.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start/stop with ⌃⌥⌘R, the hotbar, or the menu bar while sharing. Recordings use the capture frame rate set under General and pause together with privacy pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten oder beenden mit ⌃⌥⌘R, der Aktionsleiste oder der Menüleiste während einer Freigabe. Aufnahmen verwenden die unter „Allgemein“ festgelegte Bildrate und pausieren zusammen mit der Privatsphärenpause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez ou arrêtez avec ⌃⌥⌘R, la barre d’actions ou la barre des menus pendant un partage. Les enregistrements utilisent la fréquence définie dans Général et se suspendent avec la pause de confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o detén con ⌃⌥⌘R, la barra de acciones o la barra de menús mientras compartes. Las grabaciones usan la frecuencia configurada en General y se pausan junto con la pausa de privacidad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享时可使用 ⌃⌥⌘R、操作栏或菜单栏开始/停止。录制使用“通用”中设置的帧率，并会随隐私暂停一起暂停。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有中に⌃⌥⌘R、操作バー、またはメニューバーで開始／停止します。録画には「一般」で設定したフレームレートが使われ、プライバシー一時停止と同時に一時停止します。"
          }
        }
      }
    },
