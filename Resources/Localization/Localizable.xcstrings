    "settings.general.shareModeHiddenCaption": {
      "comment": "User-facing text: The region mirrors into an invisible window named “%@” — pick it under “share window”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region mirrors into an invisible window named “%@” — pick it under “share window”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bereich wird in ein unsichtbares Fenster namens „%@“ gespiegelt — wähle es unter „Fenster teilen“ aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone est recopiée dans une fenêtre invisible nommée « %@ » — choisissez-la dans « partager une fenêtre »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región se refleja en una ventana invisible llamada «%@»; selecciónala en «compartir ventana»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域会镜像到名为“%@”的不可见窗口中，请在“共享窗口”下选择它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲は「%@」という非表示ウインドウへミラーリングされます。「ウインドウを共有」から選択してください。"
          }
        }
      }
    },
    "settings.general.shareModeVirtualDisplayCaption": {
      "comment": "User-facing text: The region appears as an extra monitor — pick it under “share screen”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region appears as an extra monitor — pick it under “share screen”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bereich erscheint als zusätzlicher Monitor — wähle ihn unter „Bildschirm teilen“ aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone apparaît comme un moniteur supplémentaire — choisissez-la dans « partager l’écran »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región aparece como un monitor adicional; selecciónala en «compartir pantalla»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域会显示为额外的显示器，请在“共享屏幕”下选择它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲が追加モニターとして表示されます。「画面を共有」から選択してください。"
          }
        }
      }
    },
    "settings.general.shareModeVirtualMonitorCaption": {
      "comment": "User-facing text: A separate empty screen — drag windows onto it and only they are shared. A large preview panel shows what's on it; share it under “share screen”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate empty screen — drag windows onto it and only they are shared. A large preview panel shows what's on it; share it under “share screen”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein separater leerer Bildschirm — ziehe Fenster darauf, und nur diese werden geteilt. Ein großes Vorschaupanel zeigt seinen Inhalt; teile ihn unter „Bildschirm teilen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran vide distinct : faites-y glisser des fenêtres et seules celles-ci seront partagées. Un grand panneau d’aperçu affiche son contenu ; partagez-le dans « partager l’écran »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla vacía independiente: arrastra ventanas a ella y solo se compartirán esas ventanas. Un panel de vista previa grande muestra su contenido; compártela en «compartir pantalla»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个独立的空白屏幕：将窗口拖入后，只会共享这些窗口。大型预览面板会显示其内容；请在“共享屏幕”下共享它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した空の画面です。ウインドウを移動すると、そのウインドウだけが共有されます。大きなプレビューパネルに内容が表示されるので、「画面を共有」から共有してください。"
          }
        }
      }
    },
    "settings.general.shareWindowCaption": {
      "comment": "User-facing text: The name sharing apps list for the share window in their window pickers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name sharing apps list for the share window in their window pickers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name, unter dem Freigabe-Apps das Freigabefenster in ihrer Fensterauswahl anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom sous lequel les apps de partage affichent la fenêtre dans leur sélecteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre que las apps de uso compartido muestran para la ventana en sus selectores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
