    "settings.recording.audioCaption": {
      "comment": "User-facing text: System audio is what the captured apps play (Outcut Share itself is excluded). The microphone asks for permission on its first recording; privacy pause silences both tracks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio is what the captured apps play (Outcut Share itself is excluded). The microphone asks for permission on its first recording; privacy pause silences both tracks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaudio ist der Ton der aufgenommenen Apps (Outcut Share selbst ist ausgeschlossen). Das Mikrofon fragt bei der ersten Aufnahme nach einer Berechtigung; die Privatsphärenpause schaltet beide Spuren stumm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio système correspond au son émis par les apps capturées (Outcut Share est exclu). Le microphone demande une autorisation lors du premier enregistrement ; la pause de confidentialité coupe les deux pistes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio del sistema es lo que reproducen las apps capturadas (Outcut Share está excluido). El micrófono solicita permiso en la primera grabación; la pausa de privacidad silencia ambas pistas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统音频是被捕捉 App 播放的声音（Outcut Share 本身除外）。首次录制时麦克风会请求权限；隐私暂停会将两条音轨静音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムオーディオはキャプチャ対象アプリの音声です（Outcut Share自体は除外）。マイクは最初の録画時にアクセスを要求し、プライバシー一時停止中は両方のトラックが無音になります。"
          }
        }
      }
    },
