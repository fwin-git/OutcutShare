{
  "sourceLanguage" : "en",
  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy prompt explaining why Outcut Share may access the microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen enthalten den Mikrofonton, wenn dies unter „Einstellungen“ → „Aufnahme“ aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordings include your microphone when enabled in Settings → Recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones incluyen el audio del micrófono cuando está activado en Ajustes → Grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements incluent le son de votre microphone lorsque cette option est activée dans Réglages → Enregistrement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」→「録画」で有効にすると、録画にマイクの音声が含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”→“录制”中启用麦克风后，录制内容将包含麦克风音频。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gravações incluem o áudio do microfone quando essa opção está ativada em Ajustes → Gravação."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 녹화에서 활성화하면 녹화에 마이크 오디오가 포함됩니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」→「錄製」中啟用後，錄製內容會包含麥克風音訊。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni includono l’audio del microfono quando è abilitato in Impostazioni → Registrazione."
          }
        }
      }
    }
  },
  "version" : "1.0"
